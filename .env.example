# Web UI (omit both to run in demo mode with the in-browser fake backend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# api Edge Function (set with `supabase secrets set`; SUPABASE_* are provided by the platform)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HARBOR_ALLOWED_ORIGIN=http://localhost:5173

# Stripe (Identity + Issuing) — TEST MODE ONLY. sk_live_ keys are refused. Leave empty to use fakes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Plaid — sandbox only (PLAID_ENV must be "sandbox"). Leave empty to use the fake bank link.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Force fake providers even when keys are present (CI)
HARBOR_FORCE_FAKE=0
